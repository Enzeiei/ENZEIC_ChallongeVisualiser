# Get this at https://challonge.com/settings/developer
CHALLONGE_API_KEY=

# Only needed if you switch lib/challonge-client.js to use OAuth instead
CHALLONGE_OAUTH_TOKEN=

# Required for the live scoreboard server (server.js).
# This is the tournament whose "underway" matches will be displayed.
# It's the numeric tournament id, or the "url" slug — either works with the API.
CHALLONGE_TOURNAMENT_ID=

# Optional — how often the SERVER polls Challonge when auto-refresh is on (ms).
# Defaults to 20000 (20s) if unset. Minimum enforced is 5000ms.
POLL_INTERVAL_MS=20000

# Optional — port for the scoreboard web server
PORT=3000
